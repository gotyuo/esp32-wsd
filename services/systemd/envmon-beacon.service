[Unit]
Description=EnvMon device discovery beacon server (20261006-v1.1)
Documentation=file:/opt/envmon-beacon/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/envmon-beacon
# 多网卡机器把 --interface 改成实际出口 IP（如 192.168.2.220）
ExecStart=/usr/bin/python3 -u /opt/envmon-beacon/beacon_server.py --config /opt/envmon-beacon/projects.json
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal
SyslogIdentifier=envmon-beacon

[Install]
WantedBy=multi-user.target
