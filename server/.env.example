# 复制为 .env 并按需修改（docker-compose 会自动读取同目录 .env）
# 端口使用非常规值，降低被扫描风险
MQTT_PORT=18830
WEB_PORT=12090

# MQTT 账号（设备配网页需填同样的值）
MQTT_USER=envmon
MQTT_PASS=envmon-secret

# 管理接口令牌（旧版兼容：设置后，X-Admin-Token 头仍可调用写接口）
# 留空则仅使用登录会话鉴权
ADMIN_TOKEN=

# 管理员账号（首次启动自动创建）
ADMIN_USER=admin
# 生产环境务必修改！超过默认密码有安全风险
ADMIN_PASS=admin123

# 登录会话有效期（小时，默认 168 = 7 天）
SESSION_TTL_HOURS=168

# 数据保留策略
RAW_RETENTION_DAYS=7
MINUTE_RETENTION_DAYS=400

# ================================================================
# TTS 语音合成（Piper 本地神经 TTS）
# ================================================================
# 语音模型（格式：<语言>-<名称>-<质量>）
# 中文推荐: zh_CN-huayan-medium
# 英文推荐: en_US-lessac-medium
TTS_VOICE=zh_CN-huayan-medium

# 语音播报开关（1=开启报警自动语音播报，0=关闭）
TTS_ENABLED=1
