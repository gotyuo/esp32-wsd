# ============================================================
# 物联网环境监测系统 - 环境变量配置示例
# 复制为 .env 并修改: cp .env.example .env
# ============================================================

# --- 端口 ---
# MQTT 设备接入端口（对外暴露）
MQTT_PORT=18830
# Web 管理界面/API 端口
WEB_PORT=12090

# --- MQTT 认证 ---
MQTT_USER=envmon
MQTT_PASS=envmon

# --- 管理员 ---
ADMIN_USER=admin
ADMIN_PASS=admin123
# 旧版静态管理令牌（可选，留空则用账号密码登录）
ADMIN_TOKEN=

# --- 会话 ---
SESSION_TTL_HOURS=168

# --- 数据保留 ---
RAW_RETENTION_DAYS=7
MINUTE_RETENTION_DAYS=400

# --- TTS 语音合成 ---
# 语音模型（首次启动自动下载）
TTS_VOICE=zh_CN-huayan-medium
# 语音播报开关（1=开启, 0=关闭）
TTS_ENABLED=1

# --- 集成平台接收（HIS → EnvMon）---
# 集成平台 XML 接收接口鉴权 token（留空=不鉴权，生产请务必设置）
INTEGRATION_TOKEN=
# 自动建档的重症科室关键词（逗号分隔；app_settings integration.icu_depts 可运行时覆盖）
ICU_DEPT_KEYWORDS=ICU,重症,CCU,EICU
# 集成平台消息时间相对 UTC 偏移小时（默认东八区）
INTEGRATION_TZ_OFFSET=8

# --- LAN 设备发现 / 在线判定 ---
# 监听网卡名（留空=自动选择；多网卡环境需指定，如 eth0/enp2s0）
DISC_IFACE=
# 后端扫描/应答器回复的内网 IP（留空=自动探测宿主机 LAN IP，推荐）。
# 若部署机是多网卡/容器环境、自动探测选错网段导致【扫描不到设备】，
# 请务必在此按【宿主机实际内网 IP】显式配置，例如：
# DISC_IP=192.168.1.100
# 设备离线判定窗口（秒）：超过该时长无遥测即判离线。默认 120，需大于设备上报间隔
# （默认 10s，可在阈值页调大）。上报间隔调大时请同步调大此值。
# OFFLINE_TIMEOUT_S=120
