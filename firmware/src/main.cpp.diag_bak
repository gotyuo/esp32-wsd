#include <Arduino.h>

// 诊断: 同时往所有可能的 UART 发带标签的数据, 定位 CH340 物理连到哪路
// ESP32-S3 有 UART0/1/2. 默认: Serial=UART0(115200), Serial1=UART1, Serial2=UART2
// 板定义 ARDUINO_USB_MODE=1 时 Serial 走 USB-CDC; 我们 build_flags 已设 ARDUINO_USB_MODE=0.
// GPIO21 持续闪烁 = app 活着的硬件证据
void setup() {
    pinMode(21, OUTPUT);
    // 同时开所有串口, 不同 baud 便于区分
    Serial.begin(115200);          // 候选: 板定义下可能是 UART0 或 USB-CDC
    Serial1.begin(115200, SERIAL_8N1, 44, 43);  // 强制 UART0: RX=44, TX=43
    Serial2.begin(115200, SERIAL_8N1, 4, 3);   // UART2: 试 RX=4, TX=3 (自由引脚)
    delay(300);
}
void loop() {
    static unsigned long t0 = 0;
    static uint32_t cnt = 0;
    if (millis() - t0 >= 700) {
        t0 = millis();
        cnt++;
        digitalWrite(21, cnt & 1);
        // 每个串口发唯一标记, 抓到的那条就是 CH340 接的
        Serial.printf("  [S ] c=%lu gpio21=%d\n", cnt, (cnt & 1) ? 1 : 0);
        Serial1.printf(" [S1] UART0 c=%lu\n", cnt);
        Serial2.printf(" [S2] UART2 c=%lu\n", cnt);
    }
}