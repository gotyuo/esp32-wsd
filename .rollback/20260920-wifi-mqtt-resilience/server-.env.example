# ============================================================
# 物联网环境监测系统 - 环境变量配置示例
# 复制为 .env 并修改: cp .env.example .env
# ============================================================

# --- 端口 ---
# MQTT 设备接入端口（对外暴露）
MQTT_PORT=18830
# Web 管理界面/API 端口
WEB_PORT=12090

# --- MQTT 认证 ---
MQTT_USER=envmon
MQTT_PASS=envmon

# --- 管理员 ---
ADMIN_USER=admin
ADMIN_PASS=admin123
# 旧版静态管理令牌（可选，留空则用账号密码登录）
ADMIN_TOKEN=

# --- 会话 ---
SESSION_TTL_HOURS=168

# --- 数据保留 ---
RAW_RETENTION_DAYS=7
MINUTE_RETENTION_DAYS=400

# --- TTS 语音合成 ---
# 语音模型（首次启动自动下载）
TTS_VOICE=zh_CN-huayan-medium
# 语音播报开关（1=开启, 0=关闭）
TTS_ENABLED=1

# --- LAN 设备发现 ---
# 监听网卡名（留空=自动选择；多网卡环境需指定，如 eth0/enp2s0）
DISC_IFACE=
# 强制回复给设备的 IP（留空=自动探测网卡 IP）
# DISC_IP=192.168.1.100
